# FinAI Environment Configuration

# Application
APP_ENV=development
APP_NAME=FinAI
DEBUG=True
LOG_LEVEL=INFO
API_V1_STR=/api/v1
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL with asyncpg or fallback)
DATABASE_URL=postgresql+asyncpg://finai_user:finai_password@localhost:5432/finai_db
DATABASE_SYNC_URL=postgresql+psycopg://finai_user:finai_password@localhost:5432/finai_db

# Security & Authentication
JWT_SECRET_KEY=finai_super_secret_jwt_key_change_in_production_min32bytes_required
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
LOGIN_RATE_LIMIT_PER_MINUTE=5

# OpenAI & AI Assistant
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
